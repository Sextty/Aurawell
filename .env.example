# Prisma / PostgreSQL connection
DATABASE_URL=postgresql://aurawell:aurawell@postgres:5432/aurawell

# API port
PORT=4400

# JWT signing secret — change this in any real deployment
JWT_SECRET=change-me-in-production

# CORS allowed origins (comma-separated)
CORS_ORIGIN=http://localhost:5173,http://localhost

# Auth rate limiting
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_ATTEMPTS=10
